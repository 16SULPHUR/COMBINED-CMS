# Supabase transaction pooler URI (port 6543), from Project Settings > Database > Connect
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
# Long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public URL of this CMS, e.g. https://cms.example.com (http://localhost:3000 locally)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
# Comma-separated frontends allowed to call the API with credentials
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Supabase Storage (S3 protocol) for Media uploads; leave S3_BUCKET empty to store files on local disk
SUPABASE_URL=https://<project-ref>.supabase.co
S3_BUCKET=media
S3_ENDPOINT=https://<project-ref>.storage.supabase.co/storage/v1/s3
S3_REGION=<project-region>
# Storage > S3 Connection > New access key
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
